# Copy to .env and fill in real values. See README.md for details.

# Supabase Postgres connection string (transaction pooler, port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Shared bearer token required on every API route except /health.
API_TOKEN=dev-secret-token

# Resend (https://resend.com) - used to send DOI verification emails.
RESEND_API_KEY=re_your_resend_api_key
DOI_FROM_EMAIL=verified-sender@example.com

# Public base URL of the client app. Only the DOI `type: "page"` flow needs it -
# that is where the emailed link points: {CLIENT_BASE_URL}/verify?memberId=...&code=...
CLIENT_BASE_URL=http://localhost:3000
