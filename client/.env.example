# Copy to .env and fill in real values.

# Admin console login (used by the login Server Action).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secret key used to sign the admin session cookie (any long random string).
AUTH_SECRET=change-me-too

# Upstream Loyalty Engine API this console proxies to.
API_BASE_URL=http://127.0.0.1:8000
# Must match the API's own API_TOKEN.
API_TOKEN=dev-secret-token
