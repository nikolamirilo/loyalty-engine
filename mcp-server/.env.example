# Copy to .env and fill in real values.

# Base URL of the loyalty-engine FastAPI service this MCP server calls.
LOYALTY_API_BASE_URL=http://localhost:8000

# The loyalty API's own bearer token (its API_TOKEN) - used for every
# outbound call this server makes to the loyalty API, regardless of which
# external MCP client is asking. Never handed out to MCP clients themselves.
LOYALTY_API_SERVICE_TOKEN=dev-secret-token

# JSON array of external callers allowed to use this MCP server, each with
# its own bearer token and scopes. Scopes: "read", "write", or "admin"
# ("admin" satisfies any scope check; no tools require it yet). Revoke a
# caller by removing its entry here - it never touches LOYALTY_API_SERVICE_TOKEN.
MCP_CLIENT_TOKENS=[{"token":"dev-mcp-token","name":"local-dev","scopes":["read","write"]}]

# Optional: seconds to wait on a call to the loyalty API before giving up. Default 15.
LOYALTY_API_TIMEOUT_SECONDS=15
